def create_isos_if_needed(source_paths: list) -> list:
    """Create ISOs from files or folders if they don't exist. Returns list of ISO paths."""
    if not source_paths:
        return []

    iso_paths = []
    for source_path in source_paths:
        iso_path = source_path + ".iso"
        if not os.path.exists(iso_path):
            # depends on genisoimage package, make sure to install it first
            run(
                [
                    "mkisofs",
                    "-r",
                    "-jcharset",
                    "utf8",
                    "-o",
                    iso_path,
                    source_path,
                ]
            )
        iso_paths.append(iso_path)
    return iso_paths


def parse_folder_arg(folder_str: str) -> tuple:
    """Parse folder argument into (path, is_readonly).

    Supports:
        /path/to/folder      -> (/path/to/folder, True)
        /path/to/folder:rw   -> (/path/to/folder, False)
        /path/to/folder:ro   -> (/path/to/folder, True)
    """
    if folder_str.endswith(":rw"):
        return folder_str[:-3], False
    elif folder_str.endswith(":ro"):
        return folder_str[:-3], True
    else:
        return folder_str, True  # Default to read-only


def get_folder_size(path: str) -> int:
    """Calculate total size of a directory in bytes."""
    total = 0
    for dirpath, dirnames, filenames in os.walk(path):
        for f in filenames:
            fp = os.path.join(dirpath, f)
            if os.path.exists(fp):
                total += os.path.getsize(fp)
    return total


def get_fat_folders(folders: list, start_index: int = 10) -> list:
    """Build QEMU drive arguments for FAT folder mounts.

    Args:
        folders: List of folder strings (path with optional :rw/:ro suffix)
        start_index: Starting drive index (default 10 to avoid conflicts with main drives)

    Returns:
        List of QEMU -drive arguments
    """
    if not folders:
        return []

    drives = []
    for i, folder_str in enumerate(folders):
        folder_path, readonly = parse_folder_arg(folder_str)
        abs_path = os.path.abspath(folder_path)

        if not os.path.exists(abs_path):
            print(f"Warning: Folder not found, skipping: {folder_path}")
            continue

        if not os.path.isdir(abs_path):
            print(f"Warning: Not a directory, skipping: {folder_path}")
            continue

        mode = "ro" if readonly else "rw"
        drive_index = start_index + i

        # Calculate folder size to determine FAT type
        folder_size = get_folder_size(abs_path)
        # FAT16 limit is ~500MB, use FAT32 for larger folders
        fat_type = ",fat-type=32" if folder_size > 400 * 1024 * 1024 else ""

        # QEMU FAT driver: appears as a removable FAT drive in guest
        drives += [
            "-drive",
            f"file=fat:{mode}:{abs_path}{fat_type},index={drive_index},format=raw,media=disk,if=virtio",
        ]

    return drives


def parse_port_mapping(port_str: str) -> tuple:
    """Parse host:guest port string into tuple (host_port, guest_port)."""
    parts = port_str.split(":")
    if len(parts) != 2:
        raise ValueError(f"Invalid port format '{port_str}'. Expected HOST:GUEST (e.g., 8080:80)")
    return int(parts[0]), int(parts[1])


def add_ports(use_defaults: bool, custom_ports: list, defaults: dict) -> list:
    """Build port forwarding arguments for QEMU.

    Args:
        use_defaults: Whether to include default port mappings
        custom_ports: List of custom port strings in HOST:GUEST format
        defaults: Configuration defaults including ports_passthrough
    """
    ports = {}

    # Add default ports if requested
    if use_defaults:
        ports.update(defaults["ports_passthrough"])

    # Add custom ports
    if custom_ports:
        for port_str in custom_ports:
            host_port, guest_port = parse_port_mapping(port_str)
            ports[guest_port] = host_port

    if not ports:
        return []

    port_string = ",".join(
        f"hostfwd=tcp:127.0.0.1:{host_port}-0.0.0.0:{guest_port}"
        for guest_port, host_port in ports.items()
    )
    return ["-nic", f"user,{port_string}"]


def is_windows_image(image_path: str) -> bool:
    """Check if image appears to be a Windows VM based on filename."""
    name_lower = image_path.lower()
    return "w11" in name_lower or "windows" in name_lower


def needs_sudo(image_path: str) -> bool:
    """Check if image requires sudo (raw device access)."""
    return image_path.startswith("/dev/")


def extract_ova(ova_path: str) -> str:
    """Extract OVA file and return path to extracted VMDK."""
    folder = ".".join(ova_path.split(".")[:-1])
    with tarfile.TarFile(ova_path, "r") as tf:
        tf.extractall(folder)
    vmdk_files = [f for f in os.listdir(folder) if f.endswith(".vmdk")]
    if not vmdk_files:
        shutil.rmtree(folder, ignore_errors=True)
        raise ValueError(f"No VMDK file found in OVA: {ova_path}")
    extracted_path = folder + ".vmdk"
    source_path = os.path.join(folder, vmdk_files[0])
    os.rename(source_path, extracted_path)
    shutil.rmtree(folder)
    return extracted_path


def get_image_format(image_path: str) -> str:
    """Get QEMU format string for image file."""
    if image_path.startswith("/dev/"):
        return "raw"
    formats_found = [fmt for ext, fmt in formats.items() if image_path.endswith(ext)]
    if not formats_found:
        raise ValueError(f"Unknown image format for: {image_path}")
    return formats_found[0]


def get_media_type(image_path: str) -> str:
    """Determine media type (cdrom or disk) for image."""
    return "cdrom" if image_path.endswith(".iso") else "disk"


def create_image_if_missing(image_path: str, defaults: dict, fixed_size: bool = False) -> None:
    """Create disk image if it doesn't exist."""
    if os.path.exists(image_path):
        return

    img_format = get_image_format(image_path)
    subformat = []
    # Fixed size for Ventoy images or when --fixed-size flag is used
    if image_path.endswith("vhd.vtoy") or (fixed_size and image_path.endswith(".vhd")):
        subformat = ["-o", "subformat=fixed"]
    elif image_path.endswith("vdi.vtoy") or (fixed_size and image_path.endswith(".vdi")):
        subformat = ["-o", "static=on"]
    elif fixed_size:
        # For qcow2 and other formats, we can't easily make fixed size
        # but we can preallocate
        subformat = ["-o", "preallocation=metadata"]

    run(
        ["qemu-img", "create", "-f", img_format]
        + subformat
        + [image_path, defaults["image_size_to_create"]]
    )


def build_drive_args(image_path: str, index: int) -> list:
    """Build QEMU drive arguments for an image."""
    img_format = get_image_format(image_path)
    media = get_media_type(image_path)
    return ["-drive", f"file={image_path},format={img_format},index={index},media={media}"]


def identify_image_types(disk_images: list, defaults: dict, fixed_size: bool = False) -> tuple:
    """Process disk images and return QEMU arguments."""
    sudo = []
    drive = []
    display = []

    for i, image in enumerate(disk_images):
        if is_windows_image(image):
            display = ["-display", "sdl"]
        if needs_sudo(image):
            sudo = ["sudo"]
        if image.endswith(".ova"):
            image = extract_ova(image)

        create_image_if_missing(image, defaults, fixed_size)
        drive += build_drive_args(image, i)

    return sudo, drive, display


def get_bios_and_acceleration(os_families: dict) -> tuple:
    default_bios = None
    os_family_info = os_families.get(os_family, default_bios)

    if not os_family_info:
        raise NotImplementedError

    accel = os_family_info["accel"]
    bios = next(
        (path for path in os_family_info["bios_paths"] if os.path.isfile(path)),
        default_bios,
    )
    if not bios:
        ovmf_link = "https://github.com/clearlinux/common/raw/master/OVMF.fd"
        file_path = os.path.join(config_folder, "OVMF.fd")
        if not os.path.exists(file_path):
            with urllib.request.urlopen(ovmf_link) as response, open(
                file_path, "wb"
            ) as out_file:
                data = response.read()
                out_file.write(data)
        bios = file_path

    return bios, accel


def main():
    defaults = set_defaults(gl_defaults)
    argparsed, not_argparsed = parse_args()

    # Override image size if --size is provided
    if argparsed.size:
        defaults["image_size_to_create"] = argparsed.size

    # Handle ISO creation and add to images list
    iso_paths = create_isos_if_needed(argparsed.make_iso)
    # Get images from positional args (if any) plus remaining unparsed args
    disk_images = list(argparsed.images) if argparsed.images else []
    disk_images.extend(filter(is_image, not_argparsed[1:]))
    disk_images.extend(iso_paths)

    sudo, drive, display = identify_image_types(disk_images, defaults, argparsed.fixed_size)
    port_fwd = add_ports(argparsed.ports_passthrough, argparsed.port, defaults)

    # Handle FAT folder mounts
    fat_drives = get_fat_folders(argparsed.folder)
    bios, accel = get_bios_and_acceleration(os_families)
    if argparsed.no_efi:
        bios = None
    mem_amount, cpu_count = get_mem_cpu(not_argparsed, defaults)
    other_args = list(filter(is_not_image, not_argparsed[1:]))
    qemu_args = [
        e for e in other_args if e not in script_options_to_exclude_from_qemu_args
    ]

    # Handle console-only mode
    if argparsed.console:
        display = []  # Remove any display settings
        qemu_args.append("-nographic")

    # I assume you are using image with the same architecture as host
    archs = {
        "x86_64": "x86_64",
        "arm64": "aarch64",
        "aarch64": "aarch64",
        "i386": "i386",
    }
    arch = archs[machine()]

    # final command to run
    command = [
        sudo,
        [f"qemu-system-{arch}"],
        accel,
        cpu_count,
        mem_amount,
        [] if bios is None else ["-bios", bios],
        qemu_args,
        drive,
        port_fwd,
        fat_drives,
        display,
        ["-snapshot"] if argparsed.snapshot else [],
    ]

    command = [item for sublist in command for item in sublist]

    print(*command)
    if not argparsed.dry_run:
        run(command)


if __name__ == "__main__":
    main()
