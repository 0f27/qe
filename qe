def is_image(s: str) -> bool:
    return any(s.endswith(ext) or s.startswith("/dev/") for ext in formats.keys())


is_not_image = lambda s: not is_image(s)


def set_defaults(defaults: dict) -> dict:
    # setting defaults
    config_path = config_folder + "/config.json"
    if os.path.exists(config_path):
        with open(config_path, "r") as f:
            defaults = json.load(f)
        # TODO - check if all fields set
    else:
        if not os.path.exists(config_folder):
            os.mkdir(config_folder)
        with open(config_path, "w") as f:
            f.write(json.dumps(defaults, indent=2))

    return defaults


def parse_args() -> tuple:
    """Parse command line arguments."""
    parser = argparse.ArgumentParser(
        description="QE - Quick Emulator: A simple wrapper for QEMU to launch VMs from the command line.",
        epilog="Examples:\n"
        "  %(prog)s ubuntu.qcow2                    # Run existing VM\n"
        "  %(prog)s new.qcow2 --size 20G             # Create and run new 20GB VM\n"
        "  %(prog)s live.iso -c                      # Run ISO with console only\n"
        "  %(prog)s disk.vmdk -s                     # Run with snapshot (no changes saved)\n"
        "  %(prog)s w11.qcow2 -i ./drivers           # Mount drivers folder as ISO\n\n"
        "All qemu-system-x86_64 parameters are also supported.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    # VM Configuration
    vm_group = parser.add_argument_group("VM Configuration")
    vm_group.add_argument(
        "images",
        nargs="*",
        help="VM image files (.qcow2, .vmdk, .vhd, .iso, etc.)",
    )
    vm_group.add_argument(
        "-s",
        "--snapshot",
        action="store_true",
        help="Run VM without saving any changes (snapshot mode)",
    )
    vm_group.add_argument(
        "-c",
        "--console",
        action="store_true",
        help="Console only mode (no GUI, adds -nographic)",
    )
    vm_group.add_argument(
        "-l",
        "--no-efi",
        "--legacy",
        action="store_true",
        help="Boot in legacy BIOS mode (default: UEFI if available)",
    )

    # Port Forwarding
    net_group = parser.add_argument_group("Port Forwarding")
    net_group.add_argument(
        "-p",
        "--ports-passthrough",
        action="store_true",
        help="Forward common ports (SSH:9922, HTTP:9980, HTTPS:9943, RDP:9989)",
    )
    net_group.add_argument(
        "--port",
        metavar="HOST:GUEST",
        type=str,
        action="append",
        help="Add custom port forwarding (e.g., --port 8080:80). Can be used multiple times",
    )

    # Image Creation
    create_group = parser.add_argument_group("Image Creation")
    create_group.add_argument(
        "--size",
        type=str,
        metavar="SIZE",
        help="Set image size for new images (e.g., 20G, 512M). Default: 40G",
    )
    create_group.add_argument(
        "--fixed-size",
        action="store_true",
        help="Create fixed-size image instead of dynamically allocated",
    )

    # ISO & Mounting
    iso_group = parser.add_argument_group("ISO & File Mounting")
    iso_group.add_argument(
        "-i",
        "--make-iso",
        metavar="PATH",
        type=str,
        action="append",
        help="Create and mount ISO from folder or file (can be used multiple times)",
    )
    iso_group.add_argument(
        "-f",
        "--folder",
        metavar="PATH[:rw]",
        type=str,
        action="append",
        help="Mount host folder as FAT drive (add :rw for read-write). Can be used multiple times",
    )

    # Output
    output_group = parser.add_argument_group("Output")
    output_group.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="Print QEMU command without running",
    )

    argparsed, not_argparsed = parser.parse_known_args()
    not_argparsed = [parser.prog] + not_argparsed

    return argparsed, not_argparsed


def get_mem_cpu(args: list, defaults: dict) -> tuple:
    # setting CPU count and memory amount
    if "-m" not in args:
        mem_amount = ["-m", defaults["memory"]]
    else:
        mem_amount = []
    if "-smp" not in args:
        cpu_count = ["-smp", defaults["cpu_cores"]]
    else:
        cpu_count = []
    return mem_amount, cpu_count


